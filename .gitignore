# Dependencies
node_modules/
server/node_modules/

# Environment and secrets (never commit)
.env
.env.local
.env.*.local
server/.env

# User-uploaded images (keep folder, not files)
uploads/*
!uploads/.gitkeep

# Site photos (JPEG/PNG/WebP): use Cloudinary (or similar) + Admin URLs — do not commit
images/**/*.jp*g
images/**/*.png
images/**/*.webp
!images/**/*.svg

# OS and editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
*.swo

# Optional: keep placeholder if you use it
# !.env.example
