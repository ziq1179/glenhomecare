# Glens Residential Home API – copy to .env and fill in
PORT=3001
API_SECRET=your-random-secret-for-tokens

# Role-based logins: set a password for each role you want to use. Whoever has that password gets that role.
# At least one of super_admin or ADMIN_PASSWORD should be set for full access.
ADMIN_PASSWORD=your-super-admin-password
# EDITOR_PASSWORD=editor-password
# PHOTO_MANAGER_PASSWORD=photo-manager-password
# REVIEW_MODERATOR_PASSWORD=review-mod-password
# VIEWER_PASSWORD=viewer-password

# Database (Neon). Get from Dashboard → Connection string.
# Leave unset to run without DB (photos won't persist).
DATABASE_URL=
